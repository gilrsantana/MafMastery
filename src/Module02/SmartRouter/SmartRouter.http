@SmartRouter_HostAddress = http://localhost:5178
@contentType = application/json

###############################################################################
# 1. DIAGNOSTICS & HEALTH ENDPOINTS
###############################################################################

### 1.1 Gateway Readiness & Health Check
# Returns gateway operational status, version and UTC timestamp
GET {{SmartRouter_HostAddress}}/health
Accept: {{contentType}}

###

### 1.2 Circuit Breaker Telemetry & Status
# Checks real-time circuit state (Closed/Open/HalfOpen), failure ratio and counters
GET {{SmartRouter_HostAddress}}/health/circuit
Accept: {{contentType}}

###

### 1.3 OpenAPI Specification
# Retrieves generated OpenAPI v3 documentation document
GET {{SmartRouter_HostAddress}}/openapi/v1.json
Accept: {{contentType}}

###

### 1.4 Providers Health Report
GET {{SmartRouter_HostAddress}}/health/providers
Accept: {{contentType}}

###

### 1.5 Providers Live Health Report
GET {{SmartRouter_HostAddress}}/health/providers?live=true
Accept: {{contentType}}

###############################################################################
# 2. CHAT COMPLETIONS (POST /v1/chat/completions)
###############################################################################

### 2.1 Heuristic Economy Tier (Prompt < 1000 characters)
# Routes to Economic provider (OpenRouter / Cohere) based on character threshold heuristic
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "messages": [
    {
      "role": "user",
      "content": "Briefly explain the Circuit Breaker pattern in microservices."
    }
  ]
}

###

### 2.2 Heuristic Premium Tier (Prompt >= 1000 characters)
# Prompt exceeds CharacterThresholdForPremiumTier (1000 chars), routing to Premium provider (Gemini)
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "messages": [
    {
      "role": "user",
      "content": "Please analyze in detail the software architecture described below and highlight coupling risks, scalability bottlenecks, and improvement opportunities according to Domain-Driven Design (DDD) and Clean Architecture principles. Architectural context: Our ecosystem runs a .NET 10 Minimal API Gateway managing multiple Large Language Model providers. It implements a heuristic routing strategy based on request character volume: prompts under 1000 characters are dispatched to an economy high-throughput, low-cost provider, while prompts reaching or exceeding this threshold are automatically routed to advanced deep-reasoning providers such as Gemini and high-capacity models. In addition to static heuristics, the infrastructure features a Circuit Breaker with continuous sampling and automatic failover should the primary provider suffer latency degradation or network errors. How would you structure bounded contexts and application layers to support per-token cost auditing and reactive resilience without compromising overall throughput?"
    }
  ]
}

###

### 2.3 Explicit Tier Preference: Economy
# Explicit directive overrides heuristic and forces Economy tier
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "routeTierPreference": "Economy",
  "messages": [
    {
      "role": "user",
      "content": "What is the difference between IAsyncEnumerable and IEnumerable in C#?"
    }
  ]
}

###

### 2.4 Explicit Tier Preference: Premium
# Explicit directive overrides heuristic and forces Premium tier (Gemini) even with a short prompt
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "routeTierPreference": "Premium",
  "messages": [
    {
      "role": "user",
      "content": "Summarize the theory of general relativity in a single poetic sentence."
    }
  ]
}

###

### 2.5 Custom Sampling Parameters & Specific Model
# Passes temperature, maxTokens and a target model
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "model": "gemini-3.5-flash-lite",
  "temperature": 0.2,
  "maxTokens": 150,
  "routeTierPreference": "Premium",
  "messages": [
    {
      "role": "user",
      "content": "List 3 essential best practices for implementing RESTful APIs."
    }
  ]
}

###

### 2.6 Multi-Turn Conversation with System Prompt
# Demonstrates context preservation with system, user, and assistant roles
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "temperature": 0.3,
  "messages": [
    {
      "role": "system",
      "content": "You are a senior software architect focused on Clean Architecture and .NET best practices."
    },
    {
      "role": "user",
      "content": "Where should repository interfaces reside in Clean Architecture?"
    },
    {
      "role": "assistant",
      "content": "Repository interfaces must reside in the application core (Domain or Application Core), ensuring business logic does not depend on infrastructure details."
    },
    {
      "role": "user",
      "content": "And where should the concrete implementation using EF Core be placed?"
    }
  ]
}

###

### 2.7 Validation Error - Bad Request (Empty Messages)
# Expects HTTP 400 Bad Request
POST {{SmartRouter_HostAddress}}/v1/chat/completions
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "messages": []
}

###

###############################################################################
# 3. STREAMING CHAT (POST /v1/chat/stream - Server-Sent Events)
###############################################################################

### 3.1 Reactive Streaming (SSE) - Economy Route
# Streams tokens asynchronously via text/event-stream using default heuristic
POST {{SmartRouter_HostAddress}}/v1/chat/stream
Content-Type: {{contentType}}
Accept: text/event-stream

{
  "messages": [
    {
      "role": "user",
      "content": "Tell a short story about a robot that discovered classical music."
    }
  ]
}

###

### 3.2 Reactive Streaming (SSE) - Explicit Premium Route
# Streams tokens via Server-Sent Events forcing Premium tier
POST {{SmartRouter_HostAddress}}/v1/chat/stream
Content-Type: {{contentType}}
Accept: text/event-stream

{
  "routeTierPreference": "Premium",
  "temperature": 0.7,
  "messages": [
    {
      "role": "user",
      "content": "Write a sonnet about quantum computing and cryptography."
    }
  ]
}
